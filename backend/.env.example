DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/gurukulam

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

PASSWORD_RESET_TOKEN_HOURS=1

# Admissions / AWS S3 (leave empty for local file storage in development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Razorpay (leave empty for demo payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMISSION_APPLICATION_FEE=500
ADMISSION_MAX_DOCUMENT_SIZE_MB=10
PUBLIC_API_BASE_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=admissions@gurukulam.local
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_ENABLED=false
SMS_API_URL=
SMS_API_TOKEN=
PUBLIC_APP_BASE_URL=http://localhost:3000/apply
DATA_CONSENT_VERSION=v1.0

# ---------------------------------------------------------------------------
# Feedback & Issue Management — integrations (Sprint 7)
# See docs/sprint-7/README.md and GET /api/v1/feedback/integrations/
# ---------------------------------------------------------------------------
FEEDBACK_DEFAULT_ENV=PRODUCTION
FEEDBACK_ISSUE_TRACKER=GITHUB
FEEDBACK_AUTO_CREATE_ISSUE=false

# GitHub Issues
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_API_URL=https://api.github.com
# Optional comma-separated labels that exist in your repo (leave empty to use bug/feature only)
GITHUB_LABELS=
# Milestone title or number (optional — applied on issue create)
GITHUB_MILESTONE=
# GitHub Projects v2 node ID (optional — add issue to project after create)
GITHUB_PROJECT_NODE_ID=
# Base branch for auto-created issue branches (empty = repo default branch)
GITHUB_DEFAULT_BRANCH=
# Optional prefix for branch names, e.g. feature/
GITHUB_BRANCH_PREFIX=
# Branch name template — tokens: {issue}, {feedback_number}, {gurukulam_id}, {slug}
GITHUB_BRANCH_NAME_TEMPLATE={issue}-{feedback_number}-{gurukulam_id}-{slug}
# Fallback Gurukulam id when feedback has no branch (else uses branch.code)
GITHUB_GURUKULAM_ID=PLATFORM
# Create a git branch per issue on creation (like GitHub "Create a branch")
GITHUB_AUTO_CREATE_BRANCH=true

# GitLab Issues
GITLAB_ENABLED=false
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_API_URL=https://gitlab.com/api/v4

# Jira
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Azure Boards (Azure DevOps)
AZURE_BOARDS_ENABLED=false
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_BOARDS_WORK_ITEM_TYPE=Bug
AZURE_DEVOPS_API_URL=https://dev.azure.com

# Slack (feedback ops notifications)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#feedback-ops
SLACK_NOTIFY_ON_SUBMIT=false
SLACK_NOTIFY_ON_ISSUE_CREATED=true

# DJANGO_SETTINGS_MODULE=config.settings.production
# SECURE_SSL_REDIRECT=True
